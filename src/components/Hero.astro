---
import { Image } from "astro:assets";
import { site } from "../data/content";
import title from "../assets/game/title.jpg";
import logo from "../assets/game/logo.png";

// Laid out like the game's title screen: logo top-left, sections as menu entries.
const menu = [
  { href: "#gameplay", label: "Gameplay" },
  { href: "#built", label: "How It's Built" },
  { href: "#performance", label: "Performance" },
  { href: "#pipeline", label: "Art Pipeline" },
  { href: "#ai", label: "Working With AI" },
];
---

<header class="hero" id="top">
  <Image
    class="art"
    src={title}
    alt="The Titan, a giant stone knight with a glowing red heart, standing over a castle on a heather hill"
    widths={[960, 1440, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />

  <div class="side">
    <h1>
      <Image class="logo" src={logo} alt={site.title} width={498} loading="eager" />
    </h1>

    <nav aria-label="Sections">
      <ul>
        {
          menu.map((item, i) => (
            <li>
              <a href={item.href} class:list={{ first: i === 0 }}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <p class="tagline">{site.tagline}</p>
    <p class="version">Godot 4.7 · in development since July 2026</p>
  </div>
</header>

<style>
  .hero {
    position: relative;
    min-height: min(100svh, 1000px);
    display: grid;
    align-items: start;
    isolation: isolate;
    overflow: hidden;
    background: #2b313b;
  }

  .art {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 30%;
  }

  /* Darken only the left third so the menu reads, as the title screen does. */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, #1d222bdd 0%, #1d222b99 32%, #1d222b00 58%),
      linear-gradient(180deg, #12121100 70%, var(--ground) 100%);
  }

  .side {
    width: min(560px, 100%);
    padding: clamp(32px, 6vw, 72px) var(--gutter) clamp(40px, 6vw, 64px) clamp(16px, 10vw, 200px);
    display: grid;
    gap: clamp(26px, 4vw, 40px);
  }

  .logo {
    width: min(440px, 100%);
    height: auto;
  }

  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(10px, 1.6vw, 16px);
  }

  nav a {
    position: relative;
    display: inline-block;
    padding-bottom: 4px;
    font: 400 clamp(24px, 2.4vw, 30px)/1.1 var(--display);
    color: var(--bone);
    text-decoration: none;
    text-shadow: 0 2px 10px #0009;
  }

  /* Hover = the selected state of the game's menu: gold, diamond, underline. */
  nav a::before {
    content: "";
    position: absolute;
    left: -24px;
    top: 0.42em;
    width: 9px;
    height: 9px;
    background: var(--gold);
    transform: rotate(45deg);
    opacity: 0;
  }

  nav a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.18s;
  }

  nav a:hover,
  nav a:focus-visible {
    color: var(--gold);
    outline: none;
  }

  nav a:hover::before,
  nav a:focus-visible::before {
    opacity: 1;
  }

  nav a:hover::after,
  nav a:focus-visible::after {
    transform: scaleX(1);
  }

  .tagline {
    margin: 0;
    max-width: 30ch;
    font-size: 18px;
    color: var(--bone);
    text-shadow: 0 2px 10px #000;
  }

  .version {
    margin: 0;
    font-size: 14px;
    color: var(--bone-dim);
  }

  @media (max-width: 720px) {
    .hero {
      min-height: auto;
    }
    .art {
      position: relative;
      grid-row: 1;
      height: 56vw;
      object-position: 75% 30%;
    }
    .hero::before {
      background: linear-gradient(180deg, #12121100 30vw, var(--ground) 56vw);
    }
    .side {
      grid-row: 2;
      padding: 0 var(--gutter) 40px 40px;
      margin-top: -8vw;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    nav a::after {
      transition: none;
    }
  }
</style>
