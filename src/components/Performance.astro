---
import { metrics, honestNote } from "../data/content";

const fmt = (n: number): string => n.toLocaleString("en-US");
---

<section class="section" id="performance">
  <div class="wrap">
    <h2 class="title"><span>Performance</span></h2>
    <p class="intro">
      All numbers come from the project's own measurement scenes. They run headless, with the same build and the same
      seed before and after a change.
    </p>

    <div class="panel table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">Measured</th>
            <th scope="col" class="num">Before</th>
            <th scope="col" class="num">After</th>
            <th scope="col" class="num">Change</th>
          </tr>
        </thead>
        <tbody>
          {
            metrics.map((m) => (
              <tr>
                <th scope="row">
                  {m.label}
                  <span class="source">{m.source}</span>
                </th>
                <td class="num muted">
                  {fmt(m.before)} {m.unit}
                </td>
                <td class="num">
                  {m.afterText ?? fmt(m.after)} {m.unit}
                </td>
                <td class="num">÷{Math.round(m.before / m.after)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="notes">
      <h3>Where it stands</h3>
      <p>{honestNote}</p>
    </div>
  </div>
</section>

<style>
  .table-wrap {
    padding: 6px clamp(10px, 2vw, 22px);
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  th,
  td {
    padding: 14px 10px;
    text-align: left;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
  }

  tbody tr:last-child > * {
    border-bottom: 0;
  }

  thead th {
    font: 700 12px/1.3 var(--text);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--bone-dim);
  }

  tbody th {
    font-weight: 600;
  }

  .source {
    display: block;
    font-size: 13px;
    font-weight: 500;
    color: var(--bone-dim);
  }

  .num {
    text-align: right;
    white-space: nowrap;
  }

  .notes {
    max-width: 68ch;
    margin: clamp(32px, 5vw, 48px) auto 0;
    text-align: center;
  }

  .notes h3 {
    font-size: 26px;
    margin-bottom: 10px;
  }

  .notes p {
    margin: 0;
    color: var(--bone-dim);
  }

  @media (max-width: 760px) {
    th,
    td {
      padding: 12px 6px;
    }
    thead th:last-child,
    tbody td:last-child {
      display: none;
    }
  }
</style>
