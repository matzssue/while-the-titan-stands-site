---
import { stats } from "../data/content";
---

<section class="wrap" aria-label="Project in numbers">
  <dl class="stats panel">
    {
      stats.map((s) => (
        <div>
          <dt class="smallcaps">{s.label}</dt>
          <dd>
            <span class="value">{s.value}</span>
            <span class="note">{s.note}</span>
          </dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin: 0;
    padding: 22px 8px;
  }

  .stats > div {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 6px;
    padding: 4px 12px;
    text-align: center;
    border-left: 1px solid var(--rule);
  }

  .stats > div:first-child {
    border-left: 0;
  }

  dd {
    margin: 0;
    display: grid;
    gap: 2px;
  }

  .value {
    font: 700 32px/1.1 var(--text);
    color: var(--bone);
  }

  .note {
    font-size: 13px;
    line-height: 1.35;
    color: var(--bone-dim);
  }

  @media (max-width: 820px) {
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 18px;
    }
    .stats > div {
      border-left: 0;
    }
    .stats > div:last-child {
      grid-column: 1 / -1;
    }
  }
</style>
