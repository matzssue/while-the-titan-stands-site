---
import { practices, lessons } from "../data/content";
---

<section class="section" id="ai">
  <div class="wrap">
    <h2 class="title"><span>Working with Claude Code</span></h2>
    <p class="intro">
      Claude Code writes most of the code. I decide the architecture, take the measurements and review every change
      before it's merged. After four months of working this way every day, these are the rules I rely on.
    </p>

    <div class="grid">
      {
        practices.map((p) => (
          <article class="panel">
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </article>
        ))
      }
    </div>

    <div class="lessons panel">
      <h3>What I learned</h3>
      {lessons.map((l) => <p>{l}</p>)}
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  article {
    padding: 22px 24px 24px;
  }

  h3 {
    font-size: 24px;
  }

  article p {
    margin: 10px 0 0;
    color: var(--bone-dim);
    font-size: 16px;
  }

  .lessons {
    margin-top: clamp(28px, 4vw, 40px);
    padding: 26px clamp(20px, 4vw, 40px) 28px;
  }

  .lessons p {
    max-width: 72ch;
    margin: 10px 0 0;
    color: var(--bone-dim);
    font-size: 16px;
  }

  @media (max-width: 960px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
